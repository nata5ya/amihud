    {
      "cell_type": "code",
      "source": [
        "def feature_engineering(df):\n",
        "    df_features = df.copy()\n",
        "    # Calculate Illiquidity Ratio (Target Variable)\n",
        "    # ret_24h is already a fraction (e.g., 0.03 for 3%)\n",
        "    epsilon = 1e-9 # To prevent division by zero for extremely low volume\n",
        "    df_features[TARGET_COLUMN] = df_features['ret_24h'].abs() / (df_features['volume_24h'] + epsilon)\n",
        "    # Log Transformation for highly skewed features (Volume, Market Cap)\n",
        "    df_features['Log_Volume'] = np.log1p(df_features['volume_24h'])\n",
        "    df_features['Log_Mkt_Cap'] = np.log1p(df_features['mkt_cap'])\n",
        "    # Features used for prediction\n",
        "    feature_cols = [\n",
        "        'price',\n",
        "        'ret_1h',\n",
        "        'ret_24h',\n",
        "        'ret_7d',\n",
        "        'Log_Volume',\n",
        "        'Log_Mkt_Cap'\n",
        "    ]\n",
        "    # Scaling Numerical Features (Crucial for cross-sectional data)\n",
        "    scaler = StandardScaler()\n",
        "    df_features[feature_cols] = scaler.fit_transform(df_features[feature_cols])\n",
        "    # Store the scaler object (useful for deployment)\n",
        "    joblib.dump(scaler, 'feature_scaler.joblib')\n",
        "    # Separate features and target\n",
        "    X = df_features[feature_cols]\n",
        "    y = df_features[TARGET_COLUMN]\n",
        "\n",
        "    return X, y, df_features\n",
        "\n",
        "X, y, features_df = feature_engineering(df)\n",
        "\n",
        "print(\"\\n--- Features Head (After Scaling) ---\")\n",
        "print(X.head())"
